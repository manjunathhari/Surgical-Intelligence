{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "title":"Surgical Registry De-identified Export","type":"object","additionalProperties":false,
 "required":["format","version","exported_at","source","cases"],
 "properties":{
  "format":{"const":"surgical-registry-export"},"version":{"const":1},"exported_at":{"type":"string","format":"date-time"},
  "source":{"type":"object","additionalProperties":false,"required":["system","schema_family"],"properties":{"system":{"const":"surgical-registry"},"schema_family":{"const":"postgres-case-values-learning-v1"},"registry_version":{"type":["string","null"]}}},
  "cases":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["source_case_ref","procedure_module","procedure_label","surgery_date","status","values","learning_answer","learning_sealed_at","learnings","tags"],"properties":{
   "source_case_ref":{"type":"string","description":"Keyed pseudonym, not source UUID/study ID"},
   "procedure_module":{"type":"string"},"procedure_label":{"type":["string","null"]},"surgery_date":{"type":["string","null"],"format":"date"},
   "status":{"enum":["captured","pending_review","complete"]},
   "values":{"type":"array","items":{"type":"object","required":["field","value"],"properties":{"field":{"type":"string"},"value":{},"source":{"type":["string","null"]},"evidence":{"type":["string","null"]},"changed_at":{"type":["string","null"],"format":"date-time"}}}},
   "learning_answer":{"enum":["nothing","yes",null]},"learning_sealed_at":{"type":["string","null"],"format":"date-time"},
   "learnings":{"type":"array","items":{"type":"object","required":["ordinal","shown_by","sign_tags","items","amendments","added_after_seal"],"properties":{
    "ordinal":{"type":"integer","minimum":1,"maximum":3},"shown_by":{"enum":["photo","clip","nothing"]},"sign_tags":{"type":"array","items":{"type":"string"}},
    "how_showed":{"type":["string","null"]},"items":{"type":"array","items":{"type":"object","required":["slot","text","origin"],"properties":{"slot":{"type":"string"},"text":{"type":"string"},"origin":{"enum":["own_words","box","asked"]}}}},
    "amendments":{"type":"array","items":{"type":"object","required":["slot","text","created_at"],"properties":{"slot":{"type":"string"},"text":{"type":"string"},"created_at":{"type":"string","format":"date-time"}}},
    "added_after_seal":{"type":"boolean"}}}},
   "tags":{"type":"array","items":{"type":"string"}}
  }}}
 }
}
