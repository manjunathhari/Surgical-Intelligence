{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/manjunathhari/Surgical-Intelligence/schemas/publication-import-v1.schema.json",
  "title": "Surgical Intelligence retained publication import v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "version",
    "exported_at",
    "source_system",
    "papers"
  ],
  "properties": {
    "format": {
      "const": "surgical-intelligence-publication-import"
    },
    "version": {
      "const": 1
    },
    "exported_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_system": {
      "type": "string",
      "minLength": 1
    },
    "retained_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "papers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/paper"
      }
    }
  },
  "$defs": {
    "paper": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_ref",
        "title",
        "authors",
        "retention_state",
        "claims"
      ],
      "properties": {
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "doi": {
          "type": [
            "string",
            "null"
          ]
        },
        "pmid": {
          "type": [
            "string",
            "null"
          ]
        },
        "pmcid": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "journal": {
          "type": [
            "string",
            "null"
          ]
        },
        "publication_year": {
          "type": [
            "integer",
            "null"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "retention_state": {
          "enum": [
            "kept",
            "hidden",
            "unreviewed"
          ]
        },
        "decision_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "file": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/file"
            }
          ]
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          }
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storage_ref",
        "mime_type",
        "sha256",
        "byte_length",
        "export_authorized"
      ],
      "properties": {
        "storage_ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*://)(?!.*[?#]).+$"
        },
        "mime_type": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "byte_length": {
          "type": "integer",
          "minimum": 0
        },
        "export_authorized": {
          "const": true
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_ref",
        "claim",
        "limitations",
        "epistemic_status",
        "review_state"
      ],
      "properties": {
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": [
            "string",
            "null"
          ]
        },
        "population": {
          "type": [
            "string",
            "null"
          ]
        },
        "intervention": {
          "type": [
            "string",
            "null"
          ]
        },
        "comparator": {
          "type": [
            "string",
            "null"
          ]
        },
        "outcome": {
          "type": [
            "string",
            "null"
          ]
        },
        "effect_estimate": {
          "type": [
            "string",
            "null"
          ]
        },
        "uncertainty": {
          "type": [
            "string",
            "null"
          ]
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "epistemic_status": {
          "enum": [
            "observed",
            "reported",
            "inferred",
            "hypothesis"
          ]
        },
        "review_state": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
